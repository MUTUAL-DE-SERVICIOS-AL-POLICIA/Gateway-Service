# Puerto interno en el que el gateway levanta NestJS.
PORT=3000

# Lista de orígenes permitidos para CORS separada por comas.
FRONTEND_SERVERS="http://localhost:3001,http://localhost:3002"

# URL base de la integración PVT BE.
PVT_BE_API_SERVER="http://localhost:<port>"
# URL base del backend PVT-STI; el gateway le agrega /api para consultas de prestamos y aportes.
PVT_BACKEND_API_SERVER="http://localhost:<port>"

# Secreto con el que se valida el token hash de peticiones PVTBE.
PVT_HASH_SECRET="secret"

# Host del servidor FTP que usa el gateway para gestionar archivos.
FTP_HOST=192.168.2.000
# Usuario con el que el gateway autentica la sesión FTP.
FTP_USERNAME=test_pruebas
# Contraseña usada para abrir la conexión FTP.
FTP_PASSWORD=test
# Ruta raíz sobre la que el gateway construye operaciones de archivos.
FTP_ROOT="/test_pruebas"
# Indica si la conexión FTP debe usar SSL.
FTP_SSL=false

# URL base del proveedor SMS.
SMS_SERVER_URL="http://172.16.1.XX/goip/en"
# Usuario o identificador esperado por el proveedor SMS.
SMS_SERVER_ROOT="root"
# Contraseña que el gateway envía al proveedor SMS.
SMS_SERVER_PASSWORD="TEST1234"
# Identificador del proveedor o canal SMS.
SMS_PROVIDER="1"

# URL base del integrador de WhatsApp.
WHATSAPP_SERVER_URL=""

# URL base del proveedor de ciudadanía digital.
CITIZENSHIP_DIGITAL_CLIENT_URL="https://proveedor.bo"
# Identificador del cliente registrado ante ciudadanía digital.
CITIZENSHIP_DIGITAL_CLIENT_ID="YYYYYYYYYYYYYYYY"
# Redirect URI usada en el flujo de ciudadanía digital.
CITIZENSHIP_DIGITAL_REDIRECT_URI="com.YYYYYY.pvt:/"
# Atributos solicitados al proveedor de ciudadanía digital.
CITIZENSHIP_DIGITAL_SCOPES="openid profile fecha_nacimiento email celular offline_access"

